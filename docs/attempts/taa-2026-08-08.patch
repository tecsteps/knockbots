+  /**
+   * @param {THREE.Camera} camera
+   * @param {number} feedback history weight per frame, 0..1
+   */
+  constructor(camera, feedback = 0.90) {
+    super();
+    this.camera = camera;
+    this.needsSwap = true;
+
+    this.uniforms = {
+      tDiffuse: { value: null },
+      tHistory: { value: null },
+      tDepth: { value: null },
+      uInvViewProjection: { value: new THREE.Matrix4() },
+      uPrevViewProjection: { value: new THREE.Matrix4() },
+      uJitterUv: { value: new THREE.Vector2() },
+      uTexel: { value: new THREE.Vector2(1 / 1632, 1 / 918) },
+      uFeedback: { value: feedback },
+      // How hard the history is pulled back into the current frame's 3x3 box.
