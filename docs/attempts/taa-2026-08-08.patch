+/**
+ * Halton(2,3), the standard low-discrepancy jitter sequence, on [-0.5, 0.5).
+ *
+ * Eight samples, not sixteen. The feedback blend gives the k-th most recent
+ * sample a weight of `alpha * (1-alpha)^k`, so with alpha 0.10 and a period of
+ * 8 the eight phases end up carrying 0.176 / 0.158 / 0.142 / 0.128 / 0.115 /
+ * 0.104 / 0.093 / 0.084 of the converged pixel — a 2.1:1 spread. At sixteen the
+ * spread is 4.4:1, which is a worse approximation of the box filter the truth
+ * arm actually is, and the extra samples buy nothing a 2x2 pixel footprint can
+ * resolve. Eight is also what UE and Unity ship.
+ *
+ * Swept rather than assumed, and the sweep says this paragraph overstates its
+ * own case: feedback 0.80 through 0.97 all land inside 0.1% of each other on
+ * the gate AND inside 1% of each other on the ghost probe. The weighting spread
+ * is real arithmetic and it is not what limits this pass.
+ */
+const HALTON_8 = (() => {
+  const radical = (i, base) => {
+    let f = 1 / base, r = 0, n = i;
+    while (n > 0) { r += f * (n % base); n = Math.floor(n / base); f /= base; }
+    return r;
+  };
+  const out = [];
+  for (let i = 1; i <= 8; i++) out.push([radical(i, 2) - 0.5, radical(i, 3) - 0.5]);
+  return out;
+})();
