+          vec3 cur = toWeighted( texture2D( tDiffuse, vUv ).rgb );
+
+          if ( uHistoryValid < 0.5 ) {
+            gl_FragColor = vec4( fromWeighted( cur ), 1.0 );
+            return;
+          }
+
+          // 3x3 neighbourhood of the CURRENT frame. This is both the clamp box
+          // and, on the diagonal taps, the only thing standing between a fast
+          // limb and a double image.
+          vec3 lo = cur, hi = cur;
+          for ( int y = -1; y <= 1; y ++ ) {
