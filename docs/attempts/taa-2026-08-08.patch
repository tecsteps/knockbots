+              if ( x == 0 && y == 0 ) continue;
+              vec3 n = toWeighted( texture2D( tDiffuse, vUv + vec2( float( x ), float( y ) ) * uTexel ).rgb );
+              lo = min( lo, n );
+              hi = max( hi, n );
+            }
+          }
