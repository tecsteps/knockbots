+          return mix( c, c / ( 1.0 + luma( c ) ), uTonemapWeight );
+        }
+        vec3 fromWeighted( vec3 c ) {
+          return mix( c, c / max( 1e-4, 1.0 - luma( c ) ), uTonemapWeight );
+        }
