{
  "name": "knockbots",
  "version": "0.1.0",
  "description": "Knockbots \u2014 a AAA-grade 3D robot fighting game in Three.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:one": "KB_SINGLEFILE=1 vite build",
    "shots": "node tools/capture.mjs",
    "touchgate": "node tools/touchgate.mjs --control=both",
    "simgate": "node tools/simgate.mjs",
    "simgate:control": "node tools/simgate.mjs --positive-control",
    "deploy": "node tools/deploy.mjs",
    "deploy:verify": "node tools/deploy.mjs --verify-only"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "playwright": "^1.62.0",
    "vercel": "^58.1.0",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "private": true
}
